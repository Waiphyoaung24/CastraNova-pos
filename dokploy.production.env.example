# Public production configuration
DOMAIN=castranova.cloud
FRONTEND_HOST=https://pos.castranova.cloud
ENVIRONMENT=production
PROJECT_NAME=CastraNova POS
BACKEND_CORS_ORIGINS=https://pos.castranova.cloud
VITE_API_URL=https://api.castranova.cloud

# Set TAG to the production Git commit SHA for each release.
TAG=REPLACE_WITH_PRODUCTION_COMMIT_SHA
DOCKER_IMAGE_BACKEND=castranova-pos-backend
DOCKER_IMAGE_FRONTEND=castranova-pos-frontend

# Initial administrator
FIRST_SUPERUSER=REPLACE_WITH_ADMIN_EMAIL
FIRST_SUPERUSER_PASSWORD=REPLACE_IN_DOKPLOY

# Application security
SECRET_KEY=REPLACE_IN_DOKPLOY

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_IN_DOKPLOY
POSTGRES_APP_USER=castranova_app
POSTGRES_APP_PASSWORD=REPLACE_IN_DOKPLOY

# Optional email provider
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# Optional Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional LINE integration
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=

# Optional error monitoring
SENTRY_DSN=
